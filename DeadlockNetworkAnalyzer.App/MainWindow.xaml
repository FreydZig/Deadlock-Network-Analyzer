<Window x:Class="DeadlockNetworkAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Deadlock Network Analyzer"
        Height="720"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>

        <Style x:Key="MetricTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SecondaryButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="DEADLOCK NETWORK ANALYZER"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Dashboard"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,10"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Game Status"
                               Style="{StaticResource MetricTitleStyle}" />
                    <TextBlock Text="{Binding GameStatusText}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,24">
            <Button Content="Start Monitoring"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding StartMonitoringCommand}"
                    Margin="0,0,12,0"
                    MinWidth="160" />
            <Button Content="Stop Monitoring"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding StopMonitoringCommand}"
                    MinWidth="160" />
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,8"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
                <TextBlock>
                    <Run Text="State: " Foreground="{StaticResource MutedTextBrush}" />
                    <Run Text="{Binding MonitoringStatusText, Mode=OneWay}"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         FontWeight="SemiBold" />
                </TextBlock>
            </Border>
        </StackPanel>

        <!-- Metric cards -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,24">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Ping" Style="{StaticResource MetricTitleStyle}" />
                    <TextBlock Text="{Binding PingText}" Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Jitter" Style="{StaticResource MetricTitleStyle}" />
                    <TextBlock Text="{Binding JitterText}" Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Packet Loss" Style="{StaticResource MetricTitleStyle}" />
                    <TextBlock Text="{Binding PacketLossText}" Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Tick Misses" Style="{StaticResource MetricTitleStyle}" />
                    <TextBlock Text="{Binding TickMissesText}" Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Chart stub -->
        <Border Grid.Row="3"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Network Timeline"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Margin="0,0,0,12" />

                <Border Grid.Row="1"
                        Background="#12161F"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Canvas>
                            <Line X1="40" Y1="40" X2="40" Y2="220"
                                  Stroke="#2A3344" StrokeThickness="1" />
                            <Line X1="40" Y1="220" X2="860" Y2="220"
                                  Stroke="#2A3344" StrokeThickness="1" />
                            <Polyline Points="40,180 120,160 200,170 280,130 360,145 440,110 520,125 600,95 680,120 760,90 840,105"
                                      Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="2.5"
                                      Fill="Transparent" />
                        </Canvas>
                        <TextBlock Text="Chart placeholder — live series will appear here"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="14" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Footer status -->
        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   Foreground="{StaticResource MutedTextBrush}"
                   FontSize="13"
                   Margin="0,16,0,0"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
